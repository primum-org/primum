{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "board-profile.schema.json",
  "title": "Board profile",
  "description": "What a board model offers: its header pins, buses, PWM channels and reserved pins, and how its GPIOs map to the lines of its GPIO chip. One file per model in boards/.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "kind", "schemaVersion", "model", "name", "gpioChip", "pins", "buses", "pwmChannels", "reserved"],
  "properties": {
    "id": { "$ref": "common.schema.json#/$defs/id" },
    "kind": { "const": "board_profile" },
    "schemaVersion": { "const": 1 },
    "model": {
      "description": "Short, stable identifier of the model, used by project files and the runtime (rpi4b). It is the profile's file name.",
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$",
      "maxLength": 40
    },
    "name": { "$ref": "common.schema.json#/$defs/name" },
    "gpioChip": { "$ref": "#/$defs/gpioChip" },
    "pins": {
      "description": "Every pin of the header, by physical number.",
      "type": "array",
      "items": { "$ref": "#/$defs/headerPin" },
      "minItems": 1
    },
    "buses": {
      "description": "Buses on the header and the GPIOs each signal uses when it is enabled.",
      "type": "array",
      "items": { "$ref": "#/$defs/bus" }
    },
    "pwmChannels": {
      "description": "Hardware PWM channels: the GPIOs listed for a channel share it, so only one of them can use it at a time.",
      "type": "array",
      "items": { "$ref": "#/$defs/pwmChannel" }
    },
    "reserved": {
      "description": "GPIOs Primum never assigns to an element.",
      "type": "array",
      "items": { "$ref": "#/$defs/reservedGpio" }
    }
  },
  "$defs": {
    "gpioChip": {
      "description": "The GPIO chip that drives the header, found by its label: the device number (/dev/gpiochipN) can change with the kernel.",
      "type": "object",
      "additionalProperties": false,
      "required": ["label"],
      "properties": {
        "label": { "type": "string", "minLength": 1, "maxLength": 80 }
      }
    },
    "headerPin": {
      "description": "A pin of the header. A gpio pin has its GPIO number, its line on the GPIO chip and its pull at power on; other pins have none of them.",
      "type": "object",
      "additionalProperties": false,
      "required": ["physical", "kind"],
      "properties": {
        "physical": { "type": "integer", "minimum": 1 },
        "kind": { "enum": ["gpio", "power_3v3", "power_5v", "ground"] },
        "gpio": { "type": "integer", "minimum": 0 },
        "line": { "type": "integer", "minimum": 0 },
        "defaultPull": { "enum": ["up", "down"] }
      }
    },
    "bus": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "signals"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9]*$" },
        "kind": { "enum": ["i2c", "spi", "uart"] },
        "signals": { "type": "array", "items": { "$ref": "#/$defs/busSignal" }, "minItems": 1 }
      }
    },
    "busSignal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "gpio"],
      "properties": {
        "name": { "type": "string", "pattern": "^[a-z][a-z0-9]*$" },
        "gpio": { "type": "integer", "minimum": 0 }
      }
    },
    "pwmChannel": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "gpios"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9]*$" },
        "gpios": { "type": "array", "items": { "type": "integer", "minimum": 0 }, "minItems": 1, "uniqueItems": true }
      }
    },
    "reservedGpio": {
      "type": "object",
      "additionalProperties": false,
      "required": ["gpio", "reason"],
      "properties": {
        "gpio": { "type": "integer", "minimum": 0 },
        "reason": { "enum": ["hat_eeprom"] }
      }
    }
  }
}
