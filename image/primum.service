# The Primum runtime. Installed by image/provision.sh; configured by /etc/primum/runtime.env.
[Unit]
Description=Primum runtime
Documentation=https://github.com/primum-org/primum

[Service]
# The runtime says when it is ready, and then that it is alive, twice in every WatchdogSec. If
# it goes silent (a stuck event loop), systemd kills it: a failure, so it is restarted.
Type=notify
NotifyAccess=main
WatchdogSec=10
User=primum
Group=primum
SupplementaryGroups=gpio
EnvironmentFile=/etc/primum/runtime.env
WorkingDirectory=/data
# Refuse to start next to other GPIO software (decision 0010). "+" runs the check as root and
# outside the sandbox: only root can see other users' processes. First of all, so that a line
# another program holds is reported as what it is, not as primum-safe failing on it.
ExecStartPre=+/opt/primum/app/image/check-gpio-users.sh
# What an earlier runtime left declared and not made safe (primum-safe was killed with it, or
# failed) is made safe before this one replaces the declaration with its own: the
# configuration may name other pins by now. If it cannot be, the service does not start.
ExecStartPre=/opt/primum/venv/bin/primum-safe
# After primum-safe, which unexports the PWM channels a crash of Primum left: one still
# exported is someone else's, and the HAL would adopt it.
ExecStartPre=+/opt/primum/app/image/check-gpio-users.sh --pwm
ExecStart=/opt/primum/venv/bin/primum-runtime
# SIGTERM makes uvicorn close the HAL, which applies the safe state (decision 0011).
TimeoutStopSec=10
# After every stop, whatever stopped it (SIGKILL and the watchdog too), before any restart:
# put the outputs the runtime declared in /data in their safe state (decision 0020). After a
# clean stop nothing is declared and it does nothing.
ExecStopPost=/opt/primum/venv/bin/primum-safe
Restart=on-failure
RestartSec=2

# Hardening: the runtime writes only /data.
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/data
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
