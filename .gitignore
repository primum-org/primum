# Only what this project produces. Keep it short: broad patterns (lib/, build/, *.manifest)
# would silently hide real files such as driver manifests.

# Python
__pycache__/
*.py[cod]
.venv/
*.egg-info/
/dist/
packages/*/dist/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# Node / web UI
node_modules/
.pnpm-store/
apps/*/dist/
apps/*/.vite/

# Environment and secrets
.env
.env.*

# Editors and OS
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db

# Local runtime data (simulated runs on the laptop)
/data/
*.primum

# Claude Code personal files (shared settings stay in .claude/settings.json)
.claude/settings.local.json
CLAUDE.local.md
