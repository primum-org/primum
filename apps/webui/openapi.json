{
  "components": {
    "schemas": {
      "AutomationStateBody": {
        "additionalProperties": false,
        "properties": {
          "enabled": {
            "title": "Enabled",
            "type": "boolean"
          },
          "id": {
            "title": "Id",
            "type": "string"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "problem": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ErrorBody"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "id",
          "name",
          "enabled",
          "problem"
        ],
        "title": "AutomationStateBody",
        "type": "object"
      },
      "DeviceBody": {
        "additionalProperties": false,
        "properties": {
          "current": {
            "title": "Current",
            "type": "boolean"
          },
          "id": {
            "title": "Id",
            "type": "string"
          },
          "name": {
            "title": "Name",
            "type": "string"
          }
        },
        "required": [
          "id",
          "name",
          "current"
        ],
        "title": "DeviceBody",
        "type": "object"
      },
      "ErrorBody": {
        "additionalProperties": false,
        "description": "Every error response: a code and its params, never text (decision 0009).",
        "properties": {
          "code": {
            "title": "Code",
            "type": "string"
          },
          "params": {
            "additionalProperties": {
              "$ref": "#/components/schemas/ErrorParam"
            },
            "title": "Params",
            "type": "object"
          }
        },
        "required": [
          "code",
          "params"
        ],
        "title": "ErrorBody",
        "type": "object"
      },
      "ErrorParam": {
        "anyOf": [
          {
            "$ref": "#/components/schemas/ErrorScalar"
          },
          {
            "items": {
              "$ref": "#/components/schemas/ErrorScalar"
            },
            "type": "array"
          }
        ]
      },
      "ErrorScalar": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "integer"
          },
          {
            "type": "number"
          },
          {
            "type": "boolean"
          }
        ]
      },
      "EventStateBody": {
        "additionalProperties": false,
        "properties": {
          "id": {
            "title": "Id",
            "type": "string"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "source": {
            "title": "Source",
            "type": "string"
          }
        },
        "required": [
